# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Dashboard do Supabase -> Project Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Canais privados do Realtime (voz). SÓ ligue depois de:
# 1) aplicar supabase/migrations/20260824000000_realtime_private_voice.sql
# 2) ativar "Allow private channels" no painel (Realtime > Settings)
# Enquanto desligado, o app usa filtro client-side de membros (funciona igual,
# com proteção um pouco menor contra clientes modificados).
VITE_REALTIME_PRIVATE=0
