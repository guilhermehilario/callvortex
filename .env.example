# Supabase — painel do projeto (Settings > API)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key

# Canais privados no Realtime (definitivo):
# 1) aplicar a migração supabase/migrations/20260824000000_realtime_private_voice.sql no painel
# 2) ativar "Allow private channels" no painel (Realtime > Settings)
# Enquanto desligado, o app usa filtro client-side de membros (funciona igual,
# com proteção um pouco menor contra clientes modificados).
VITE_REALTIME_PRIVATE=0

# Relay TURN — Cloudflare Realtime (1 TB/mês GRÁTIS):
# 1) crie conta grátis em cloudflare.com
# 2) Dashboard > Realtime > TURN Service > "Generate secret"
# 3) preencha abaixo com a URL e o secret/token que aparecerem
#    (sem isso o app usa o coturn da rede local como fallback)
VITE_TURN_URLS=turn:SEU-SUBDOMINIO.turn.cloudflare.com:3478?transport=udp,turns:SEU-SUBDOMINIO.turn.cloudflare.com:443?transport=tcp
VITE_TURN_USER=o2tab...   # o username/token exibido no dashboard
VITE_TURN_PASS=           # o secret gerado

# Fallback local: enquanto estas variáveis ficarem vazias no .env,
# o código usa o coturn da máquina do criador (rede local 192.168.18.x).
