{
  "name": "callvortex",
  "version": "0.1.4",
  "description": "Chat por texto e voz para conversar com amigos",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "check:styles": "node scripts/check-styles.mjs",
    "dist": "electron-vite build && electron-builder",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "CallVortex",
  "license": "ISC",
  "type": "commonjs",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "husky": "^9.1.7",
    "supabase": "^2.114.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "br.com.callvortex",
    "productName": "CallVortex",
    "files": [
      "out/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "portable"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "CallVortex",
      "synopsis": "Chat por texto e voz (WebRTC) para conversar com amigos",
      "description": "App de conversa por texto e voz (WebRTC) para grupos de amigos, usando Supabase."
    }
  }
}
